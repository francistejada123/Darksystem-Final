# EGradePro mail settings. Copy this file to ".env" (same folder) and fill it in.
# ".env" is never committed and cannot be opened from the browser (.htaccess).
# These values win over Settings > Email Settings.
#
# Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account > Security > 2-Step Verification > App passwords) and paste
# the 16 letters below. The normal Gmail password does NOT work.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# tls for port 587, ssl for port 465
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_account@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=your_account@gmail.com
MAIL_FROM_NAME="EGradePro"
